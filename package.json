{
  "name": "@hazlank/dsh-session-tabs",
  "version": "0.12.0",
  "description": "Chrome-style session tabs for the DSH Web GUI with unread and attention badges, toasts, and restart-safe persistence.",
  "author": "Hazlank",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hazlank/dsh-session-tabs.git"
  },
  "homepage": "https://github.com/Hazlank/dsh-session-tabs#readme",
  "bugs": {
    "url": "https://github.com/Hazlank/dsh-session-tabs/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session-tabs",
    "tabs",
    "notifications"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.2.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "capabilities": [
      "fs:read",
      "fs:write",
      "network:ingress",
      "network:egress"
    ],
    "labels": [
      "remote-access"
    ],
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js",
    "test": "node --test test/*.test.js",
    "pack:check": "npm pack --dry-run --json",
    "prepublishOnly": "npm run check && npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
